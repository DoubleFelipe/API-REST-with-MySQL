PORT=3000
HOST=0.0.0.0
API_VERSION=2.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:3000
JWT_SECRET=troque_este_segredo

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
